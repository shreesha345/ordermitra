# Copy to .env and fill in. .env is gitignored; never put real keys in this file.

# The AI agent. Without any AI key, only typed messages work, matched by keywords.
# default or nemotron. Leave empty to use whichever has a key, the default model first.
AI_PROVIDER=

# Default AI model: an API key from Google AI Studio and a model id from its model list.
# It also reads PDFs (and voice notes, if Nemotron has no audio model) when Nemotron runs the agent.
AI_API_KEY=
AI_MODEL=
# How much the model thinks before replying: low (fast WhatsApp replies), medium or high
AI_THINKING=low

# NVIDIA Nemotron through any OpenAI-compatible API: Nebius Token Factory (default), NVIDIA's API
# (https://integrate.api.nvidia.com/v1) or a self-hosted NIM. Check the exact model id in your provider's list.
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
# Optional audio-capable model for voice notes (sent as OpenAI "input_audio")
NEMOTRON_AUDIO_MODEL=
# Optional vision model for photos of order lists, strips and licences
NEMOTRON_VISION_MODEL=
# 1 lets Nemotron reason before answering (slower, sometimes better on long orders)
NEMOTRON_THINKING=

# Tavily web search, only to identify a medicine name you do not stock (it receives the name, nothing else)
TAVILY_API_KEY=

# Credit terms. Days of credit on a bill, and the prompt-payment discount as "days:percent" tiers:
# paid within 1 day 2% off, within 7 days 1%, within 15 days 0.5%. Given as a credit note.
CREDIT_DAYS=30
PROMPT_PAY_DISCOUNT=1:2,7:1,15:0.5

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_VERIFY_TOKEN=pick-any-secret-string
# App secret, used to check that webhook calls really come from Meta
WHATSAPP_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public https URL of this app, so Meta can fetch invoice PDFs and retailers can open the full-order link
# (/o/...) sent for long orders (`npm run dev:tunnel` sets it locally)
PUBLIC_BASE_URL=
# Lets `npm run dev:tunnel` register the ngrok URL as the webhook in Meta automatically
META_APP_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# In-chat payment card (UPI / card inside WhatsApp, processed by Razorpay). Name of the Razorpay payment
# configuration you created in Meta Business Suite. Leave empty to send a payment link instead.
WHATSAPP_PAYMENT_CONFIG=
# Optional: only if the products are in a Meta catalog
WHATSAPP_CATALOG_ID=

# Razorpay (use rzp_test_ keys first). Without them the Pay button sends a plain upi:// link
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL <PUBLIC_BASE_URL>/api/razorpay, event payment_link.paid, same secret here
RAZORPAY_WEBHOOK_SECRET=
UPI_ID=pharmacy@upi

# White-label: product name shown in the sidebar, browser tab, briefing, invoice footer and /logo.svg
APP_NAME=OrderMitra
# Dashboard language when a user has not picked one in the sidebar: en, hi, kn, ta or te
DASHBOARD_LANGUAGE=en
# Days from ordering with your supplier to having the stock; the demand forecast plans around it
SUPPLIER_LEAD_DAYS=7

# 1 lets "Reset demo data" wipe the store and load sample retailers and two weeks of orders.
# Without it, demo data can only be loaded into an empty store. Use for a hosted demo, never with real data.
DEMO_MODE=
# Minutes staff spend taking one order by phone; drives "staff hours saved" on the overview
CALL_MINUTES=6

# Shown on the invoice and in the sidebar
STORE_NAME=Sri Ram Medicals
STORE_ADDRESS=12, Market Road, Mangaluru 575001
STORE_DRUG_LICENCE=KA-MNG-20B/21B-1234
STORE_GSTIN=29ABCDE1234F1ZW
# Optional, printed on the invoice
STORE_PHONE=
STORE_EMAIL=
STORE_BANK=
# Invoice numbers run INV/26-27/0001, INV/26-27/0002... per financial year. Up to 5 letters.
INVOICE_PREFIX=INV

# Dashboard lock. Without a password the dashboard only opens on this computer (not through ngrok or from a phone).
# Set one to open it from other devices; the browser asks for it (any user name).
DASHBOARD_PASSWORD=
